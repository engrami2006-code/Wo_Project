# Backend settings. Copy to backend/.env (the setup scripts do this and generate JWT_SECRET).
ENVIRONMENT=development
LOG_LEVEL=INFO
# PostgreSQL (official). Dev-only fallback without PostgreSQL: sqlite:///./wo_dev.db
DATABASE_URL=postgresql+psycopg://wo:wo_dev_password@localhost:5432/wo
# At least 32 random characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT_SECONDS=8
# true = never call the weather provider (use saved snapshots / manual ET0)
WEATHER_OFFLINE_MODE=false
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
ENABLE_HSTS=false
